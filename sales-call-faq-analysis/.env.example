# GoHighLevel API credentials — copy to .env and fill in. NEVER commit .env.
#
# Create a Private Integration Token in GHL:
#   Settings -> Private Integrations -> Create new integration
# Required scopes:
#   conversations.readonly
#   conversations/message.readonly
#   contacts.readonly
GHL_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The sub-account (location) whose calls you want to analyze.
# Find it in the GHL URL: app.gohighlevel.com/v2/location/<THIS_PART>/
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx
